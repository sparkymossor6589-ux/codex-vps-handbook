# Structural example only. Add your private node named exactly: My VPS
# No production DNS policy or third-party rules are bundled.
[General]
bypass-system = true
skip-proxy = localhost,*.local,192.168.0.0/16,10.0.0.0/8

[Proxy Group]
VPS = select,My VPS,policy-select-name=My VPS

[Rule]
DOMAIN,localhost,DIRECT
DOMAIN-SUFFIX,local,DIRECT
IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
DOMAIN-SUFFIX,chatgpt.com,VPS
DOMAIN-SUFFIX,github.com,VPS
FINAL,VPS
